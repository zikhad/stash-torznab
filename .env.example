# Server URL used in generated feed and proxy links
PROTOCOL=http
HOST=127.0.0.1
PORT=3000

# Stash API
STASH_BASE_URL=https://your-stash-host:9999
STASH_API_KEY=replace_with_your_stash_api_key

# Path to tracker configuration JSON
TRACKERS_CONFIG_PATH=./trackers.example.config.json

# Cache TTL in milliseconds (default: 21600000 = 6 hours)
CACHE_TTL_MS=21600000 # 6 hours in milliseconds

# Cron expression for scheduled torrent cache refresh (default: every 6 hours)
CACHE_CRON=0 */6 * * *
