# Server URL used in generated feed and proxy links
PROTOCOL=http # Required
HOST=127.0.0.1 # Required
PORT=3000 # Required

# Stash API
STASH_BASE_URL=https://your-stash-host:9999 # Required
STASH_API_KEY=replace_with_your_stash_api_key # Required

# Path to tracker configuration JSON
TRACKERS_CONFIG_PATH=./trackers.example.config.json # Required

# Cache TTL in milliseconds (default: 21600000 = 6 hours)
CACHE_TTL_MS=21600000 # Optional

# SQLite cache file path (default: ./data/cache.sqlite)
CACHE_SQLITE_PATH=./data/cache.sqlite # Optional

# Cron expression for scheduled torrent cache refresh (default: every 6 hours)
CACHE_CRON=0 */6 * * * # Optional

# Cron expression for SQLite checkpoint+VACUUM maintenance (default: daily at 03:00)
CACHE_MAINTENANCE_CRON=0 3 * * * # Optional
